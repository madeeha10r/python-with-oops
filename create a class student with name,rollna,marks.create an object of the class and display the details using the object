
class Student:
    def __init__(self, name, rollno, marks):
        self.name = name
        self.rollno = rollno
        self.marks = marks

    def display(self):
        print("Name:", self.name)
        print("Roll Number:", self.rollno)
        print("Marks:", self.marks)

s1 = Student("Madeeha", 101, 95)
s1.display()
